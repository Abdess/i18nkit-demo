{
  "name": "transloco",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "extract": "i18nkit",
    "extract:watch": "i18nkit --watch",
    "extract:apply": "i18nkit --lang fr --auto-apply",
    "extract:sync": "i18nkit --check-sync",
    "translate": "i18nkit --translate fr:en",
    "i18n": "i18nkit --lang fr --auto-apply && i18nkit --translate fr:en"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.0.6",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.7",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@jsverse/transloco": "^8.2.0",
    "@primeuix/themes": "^2.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "primeng": "^21.0.2",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@abdess76/i18nkit": "^1.0.5",
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.2"
  }
}
